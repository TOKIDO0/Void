{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VOID",
  "version": "0.2.1",
  "identifier": "com.void.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:all",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VOID",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/void-bridge"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/TOKIDO0/Void/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMjM3M0U5QTlCRUFDNDIKUldSQ3JMNnA2WE1qUFZuOUY3Q0UvZm9FT20rSUQ4bjBjbzBpSytwN3MyMWEwdGxsdC92YzdpNVgK"
    }
  }
}
